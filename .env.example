# Zat — environment template
#
# This build ships as a static site with no backend, so none of these are read
# by anything today. They are listed because each names a real integration the
# product is architected for, and because a future deployment will need them.
# Nothing here should ever be committed with a real value.

# --- Site -------------------------------------------------------------------
# Absolute origin used for canonical URLs, Open Graph tags and share links.
ZAT_SITE_ORIGIN="https://bt3113.github.io"
# Base path. Must match `base` in app/vite.config.ts.
ZAT_BASE_PATH="/cx/"

# --- Authentication ---------------------------------------------------------
# Sessions are currently signed in the browser, which resists tampering but not
# the device owner. A real deployment moves this server-side.
ZAT_SESSION_SECRET=""
ZAT_OAUTH_GOOGLE_CLIENT_ID=""
ZAT_OAUTH_GOOGLE_CLIENT_SECRET=""

# --- Database ---------------------------------------------------------------
# Swapping the static repository for a real one is a single adapter behind
# `ContentRepository` in app/src/lib/repo/index.ts.
DATABASE_URL=""

# --- Payments ---------------------------------------------------------------
# Pricing exists; billing does not. Nothing can charge anyone in this build.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_CREATOR_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""

# --- Affiliate networks -----------------------------------------------------
# Outbound links are plain URLs today, labelled with their disclosure. Real
# networks need per-network credentials and their own terms.
AMAZON_ASSOCIATES_TAG=""
SKIMLINKS_PUBLISHER_ID=""
AWIN_API_TOKEN=""

# --- Social imports ---------------------------------------------------------
# Pulling content from platforms needs OAuth apps and review on each one.
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
YOUTUBE_API_KEY=""

# --- Email ------------------------------------------------------------------
# The contact form validates and confirms but cannot transmit without this.
RESEND_API_KEY=""
ZAT_CONTACT_TO=""

# --- Media ------------------------------------------------------------------
# Creator uploads are held as data URLs in the browser. Production needs
# first-party object storage so Story canvas generation stays same-origin.
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
